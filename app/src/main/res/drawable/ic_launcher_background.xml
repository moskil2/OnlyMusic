                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rim light on the lit side -->
    <path
        android:pathData="M54,54m-35,0a35,35 0,1 1,70 0a35,35 0,1 1,-70 0"
        android:strokeWidth="1.1">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="22" android:startY="20" android:endX="70" android:endY="70">
                <item android:offset="0" android:color="#66FFFFFF" />
                <item android:offset="0.5" android:color="#00FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
